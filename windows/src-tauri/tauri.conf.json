{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FaLe PDF",
  "version": "2.5.0",
  "identifier": "dev.fale.pdf.desktop",
  "build": {
    "frontendDist": "https://pdf.fale.network/app/"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "FaLe.dev",
    "copyright": "FaLe.dev",
    "category": "Productivity",
    "shortDescription": "PDFs lesen, ausfüllen und unterschreiben",
    "longDescription": "FaLe PDF: PDFs lesen, ausfüllen, unterschreiben, bearbeiten und umwandeln – Dateien bleiben auf deinem Gerät.",
    "homepage": "https://fale.network/apps/pdf/",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "FaLe.PDF",
        "description": "PDF-Dokument",
        "role": "Editor",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "docx"
        ],
        "name": "FaLe.Word",
        "description": "Word-Dokument",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      },
      {
        "ext": [
          "xlsx"
        ],
        "name": "FaLe.Excel",
        "description": "Excel-Tabelle",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
      },
      {
        "ext": [
          "pptx"
        ],
        "name": "FaLe.PowerPoint",
        "description": "PowerPoint-Präsentation",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.presentationml.presentation"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
