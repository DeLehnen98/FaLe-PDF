; FaLe PDF – texts of the setup program (English). Replaces Tauri's English.nsh (same names) and adds our own
; texts (fale…) for the first and the last page, see hooks.nsh.
LangString addOrReinstall ${LANG_ENGLISH} "Set up again"
LangString alreadyInstalled ${LANG_ENGLISH} "Already set up"
LangString alreadyInstalledLong ${LANG_ENGLISH} "${PRODUCTNAME} ${VERSION} is already on this PC. Choose what should happen and click Next."
LangString appRunning ${LANG_ENGLISH} "FaLe PDF is still open. Please close it first, then try again."
LangString noPermissionToCloseApp ${LANG_ENGLISH} "FaLe PDF could not be closed. Please close its window yourself, then try again."
LangString appRunningOkKill ${LANG_ENGLISH} "FaLe PDF is still open.$\n$\nPlease save open changes first. OK closes FaLe PDF and continues the setup."
LangString chooseMaintenanceOption ${LANG_ENGLISH} "Choose what should happen."
LangString chooseHowToInstall ${LANG_ENGLISH} "Choose how ${PRODUCTNAME} should be set up."
LangString createDesktop ${LANG_ENGLISH} "Put an icon on the desktop"
LangString dontUninstall ${LANG_ENGLISH} "Do not remove"
LangString dontUninstallDowngrade ${LANG_ENGLISH} "Do not remove (this setup cannot put an older version over a newer one)"
LangString failedToKillApp ${LANG_ENGLISH} "FaLe PDF could not be closed. Please close its window yourself, then try again."
LangString installingWebview2 ${LANG_ENGLISH} "Setting up Microsoft WebView2 …"
LangString newerVersionInstalled ${LANG_ENGLISH} "A newer version of ${PRODUCTNAME} is already on this PC. Putting an older one over it is not recommended. If you want that anyway, remove the existing version first. Choose what should happen and click Next."
LangString older ${LANG_ENGLISH} "older"
LangString olderOrUnknownVersionInstalled ${LANG_ENGLISH} "An $R4 version of ${PRODUCTNAME} is on this PC. Recommended: remove the existing version first. Choose what should happen and click Next."
LangString silentDowngrades ${LANG_ENGLISH} "The silent setup cannot put an older version over a newer one. Please start the setup with its window.$\n"
LangString unableToUninstall ${LANG_ENGLISH} "Removing did not work."
LangString uninstallApp ${LANG_ENGLISH} "Remove ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_ENGLISH} "Remove the existing version first"
LangString unknown ${LANG_ENGLISH} "unknown"
LangString webview2AbortError ${LANG_ENGLISH} "Microsoft WebView2 could not be set up. FaLe PDF does not start without it. Please start the setup again."
LangString webview2DownloadError ${LANG_ENGLISH} "Error: WebView2 could not be downloaded – $0"
LangString webview2DownloadSuccess ${LANG_ENGLISH} "WebView2 was downloaded"
LangString webview2Downloading ${LANG_ENGLISH} "Downloading Microsoft WebView2 …"
LangString webview2InstallError ${LANG_ENGLISH} "Error: WebView2 could not be set up (code $1)"
LangString webview2InstallSuccess ${LANG_ENGLISH} "WebView2 is set up"
LangString deleteAppData ${LANG_ENGLISH} "Also delete the files and settings kept in FaLe PDF"

; ---- our own texts (hooks.nsh) ----
LangString faleWelcomeTitle ${LANG_ENGLISH} "Set up FaLe PDF"
LangString faleWelcomeText ${LANG_ENGLISH} "Almost done: click Next, then Install.$\r$\n$\r$\nFaLe PDF opens PDF, Word, Excel and PowerPoint files. Read, fill in, sign, convert – your files stay on this PC.$\r$\n$\r$\nThe setup needs no administrator rights. It sets up FaLe PDF only: no other programs, no browser toolbars."
LangString faleFinishTitle ${LANG_ENGLISH} "FaLe PDF is set up"
LangString faleFinishText ${LANG_ENGLISH} "To open a file: drag it into the FaLe PDF window – or right-click the file and choose “Open with”.$\r$\n$\r$\nFaLe PDF is also available for phones. If you like, you can support the project – entirely optional."
LangString faleFinishRun ${LANG_ENGLISH} "Open FaLe PDF now"
LangString faleFinishLink ${LANG_ENGLISH} "First steps, phone app, support"
LangString faleFinishUrl ${LANG_ENGLISH} "https://fale.network/en/apps/pdf/welcome/"
