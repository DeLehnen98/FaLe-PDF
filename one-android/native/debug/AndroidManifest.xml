<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY (merged into debug APKs, never into release): adb hooks for the emulator smoke test.
     android.permission.DUMP is held only by the shell, so no other app can send these broadcasts. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="dev.fale.one.FaleDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
